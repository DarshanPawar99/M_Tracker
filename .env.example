# Copy this file to ".env" and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
#
#   Project URL   ->  VITE_SUPABASE_URL
#   anon public   ->  VITE_SUPABASE_ANON_KEY
#
# The app runs in a "demo / not configured" mode with sample data until these
# are set, so you can preview the UI before wiring up the backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
